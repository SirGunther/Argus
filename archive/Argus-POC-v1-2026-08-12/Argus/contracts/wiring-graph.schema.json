{
  "$id": "argus.wiring-graph.v1",
  "type": "object",
  "required": ["name", "schema_version", "contracts", "runtime_components", "services", "domain_wires", "control_wires", "run"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "contracts": { "type": "string", "minLength": 1 },
    "runtime_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "ports"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["session-controller", "supervisor", "run-controller", "result-collector"] },
          "ports": {
            "type": "object",
            "required": ["domain", "control"],
            "properties": {
              "domain": {
                "type": "object",
                "required": ["accepts", "emits"],
                "properties": {
                  "accepts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "emits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                },
                "additionalProperties": false
              },
              "control": {
                "type": "object",
                "required": ["accepts", "emits"],
                "properties": {
                  "accepts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "emits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "manifest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "manifest": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "domain_wires": {
      "type": "array",
      "items": {
        "type": "object",
          "required": ["from", "contract", "to"],
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "contract": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "control_wires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "contract", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "run": {
      "type": "object",
      "required": ["session_controller", "run_controller", "session_id", "completion_count", "timeout_ms"],
      "properties": {
        "session_controller": { "type": "string", "minLength": 1 },
        "run_controller": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "completion_count": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
