{
  "service_name": "logged-item-memory-store",
  "version": "1.0.0",
  "runtime": {
    "command": "node",
    "entrypoint": "index.mjs"
  },
  "ports": {
    "domain": {
      "accepts": ["logged-item.draft"],
      "emits": ["logged-item.stored"]
    },
    "control": {
      "accepts": [],
      "emits": ["service.failure"]
    }
  },
  "state": "owns in-memory LoggedItem records keyed by item_id",
  "side_effects": []
}
