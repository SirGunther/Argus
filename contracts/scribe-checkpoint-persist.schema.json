        "session_id": { "type": "string", "minLength": 1 },
        "transition": { "const": "batch-admitted" },
        "checkpoint": { "$ref": "argus.scribe-checkpoint.v1" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["session_id", "transition", "checkpoint", "batch"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "transition": { "const": "batch-evaluated" },
        "checkpoint": { "$ref": "argus.scribe-checkpoint.v1" },
        "batch": { "$ref": "argus.scribe-batch-evaluated.v1" }
      },
      "additionalProperties": false
    }
  ]
