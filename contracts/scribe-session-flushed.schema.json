{
  "$id": "argus.scribe-session-flushed.v1",
  "type": "object",
  "required": ["session_id", "flushed_at", "accepted", "admitted_through", "pending_rows"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "flushed_at": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "admitted_through": {
      "type": "object",
      "required": ["last_segment_id", "last_sequence", "last_revision"],
      "properties": {
        "last_segment_id": { "type": ["string", "null"], "minLength": 1 },
        "last_sequence": { "type": "integer", "minimum": -1 },
        "last_revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pending_rows": { "type": "integer", "minimum": 0 },
    "error": {
      "type": "object",
      "required": ["code", "category", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": { "enum": ["validation", "conflict", "dependency", "timeout", "unavailable", "internal", "capacity"] },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": false } } },
      "then": {
        "required": ["error"],
        "properties": { "error": { "type": "object" } }
      }
    },
    {
      "if": { "properties": { "accepted": { "const": true } } },
      "then": {
        "properties": {
          "error": false,
          "pending_rows": { "type": "integer", "maximum": 0 }
        }
      }
    }
  ]
}
