{
  "$id": "argus.ui-transcript-row.v1",
  "type": "object",
  "required": ["session_id", "segment_id", "revision", "sequence", "start_time", "end_time", "text", "provisional", "read_only", "review_flags"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "row_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "utterance_id": { "type": "string", "minLength": 1 },
    "utterance_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "revision": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "start_time": { "type": "string", "minLength": 1 },
    "end_time": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "provisional": { "type": "boolean" },
    "read_only": { "type": "boolean" },
    "dismissed": { "type": "boolean" },
    "source_segment_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "sequence", "start_time", "end_time"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "start_time": { "type": "string", "minLength": 1 },
          "end_time": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": ["first_segment_id", "last_segment_id", "start_time", "end_time"],
      "properties": {
        "first_segment_id": { "type": "string", "minLength": 1 },
        "last_segment_id": { "type": "string", "minLength": 1 },
        "start_time": { "type": "string", "minLength": 1 },
        "end_time": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "review_flags": { "type": "array", "items": { "type": "object", "required": ["reason", "candidates"], "properties": { "reason": { "type": "string", "minLength": 1 }, "candidates": { "type": "array", "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
