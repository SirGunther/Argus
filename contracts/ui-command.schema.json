{
  "$id": "argus.ui-command.v1",
  "type": "object",
  "required": ["command_id", "session_id", "command"],
  "properties": {
    "command_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "session_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "command": { "enum": ["transcript.edit", "logged-item.edit", "session.new", "session.record", "session.stop", "session.resume", "session.close", "copy", "copy-session-path", "open-folder"] },
    "segment_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "item_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "kind": { "enum": ["transcript", "logged-item"] },
    "item_ids": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "include_timestamps": { "type": "boolean" }
  },
  "additionalProperties": false
}
