{
  "$id": "argus.classification-suggestion.v1",
  "type": "object",
  "required": ["item_id", "session_id", "item_revision", "suggested_classification", "confidence", "evidence_segment_ids"],
  "properties": {
    "item_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "item_revision": { "type": "integer", "minimum": 0 },
    "suggested_classification": { "type": "string", "enum": ["task", "note", "observation", "idea"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_segment_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
