{
  "$id": "argus.ui-session-status.v1",
  "type": "object",
  "required": ["session_id", "state", "elapsed_seconds", "created_at", "duration_seconds", "transcript_count", "logged_item_count"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["recording", "stopped", "closed"] },
    "elapsed_seconds": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "minLength": 1 },
    "duration_seconds": { "type": "integer", "minimum": 0 },
    "transcript_count": { "type": "integer", "minimum": 0 },
    "logged_item_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
