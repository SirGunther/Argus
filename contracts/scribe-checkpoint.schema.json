{
  "$id": "argus.scribe-checkpoint.v1",
  "type": "object",
  "required": ["schema_version", "session_id", "saved_at", "admitted_through", "pending_partial", "background_context", "policy_id", "policy_version"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "session_id": { "type": "string", "minLength": 1 },
    "saved_at": { "type": "string", "minLength": 1 },
    "admitted_through": {
      "type": "object",
      "required": ["last_segment_id", "last_sequence", "last_revision"],
      "properties": {
        "last_segment_id": { "type": ["string", "null"] },
        "last_sequence": { "type": "integer", "minimum": -1 },
        "last_revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pending_partial": {
      "type": "object",
      "required": ["segments", "accumulated_since"],
      "properties": {
        "segments": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["segment_id", "revision", "sequence"],
            "properties": {
              "segment_id": { "type": "string", "minLength": 1 },
              "revision": { "type": "integer", "minimum": 0 },
              "sequence": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "accumulated_since": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "background_context": {
      "type": "object",
      "required": ["prior_logged_items"],
      "properties": {
        "prior_logged_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source_segment_ids"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "type": "string", "enum": ["action", "decision", "open-question", "reminder", "other"] },
              "source_segment_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "policy_id": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "in_flight_batch": {
      "type": "object",
      "required": ["batch_identity", "attempt", "dispatched_at"],
      "properties": {
        "batch_identity": { "$ref": "argus.scribe-batch-identity.v1" },
        "attempt": { "type": "integer", "minimum": 1 },
        "dispatched_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "last_evaluated_batch": { "$ref": "argus.scribe-batch-evaluated.v1" }
  },
  "additionalProperties": false
}
