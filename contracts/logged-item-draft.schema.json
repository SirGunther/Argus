{
  "$id": "argus.logged-item-draft.v1",
  "type": "object",
  "required": ["item_id", "session_id", "created_at", "text", "revision", "source", "generator"],
  "properties": {
    "item_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "revision_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["first_segment_id", "last_segment_id", "start_time", "end_time"],
      "properties": {
        "first_segment_id": { "type": "string", "minLength": 1 },
        "last_segment_id": { "type": "string", "minLength": 1 },
        "start_time": { "type": "string", "minLength": 1 },
        "end_time": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": ["implementation", "input_window_id"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "input_window_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
