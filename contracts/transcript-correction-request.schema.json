{
  "$id": "argus.transcript-correction-request.v1",
  "type": "object",
  "required": ["request_id", "session_id", "utterance_id", "boundary_id", "words", "formatting_hint", "policy"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "utterance_id": { "type": "string", "minLength": 1 },
    "boundary_id": { "type": "string", "minLength": 1 },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["word_id", "sequence", "text", "confidence", "alternatives"],
        "properties": {
          "word_id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "confidence"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "formatting_hint": { "type": "string", "enum": ["statement", "question", "exclamation", "unknown"] },
    "policy": {
      "type": "object",
      "required": ["profile", "instruction_version", "automatic_acceptance_threshold", "max_context_words"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "instruction_version": { "type": "string", "minLength": 1 },
        "automatic_acceptance_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_context_words": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
