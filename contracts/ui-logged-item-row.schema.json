{
  "$id": "argus.ui-logged-item-row.v1",
  "type": "object",
  "required": ["session_id", "item_id", "revision", "revision_id", "logged_at", "text", "source", "classification_suggestion"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "item_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "revision_id": { "type": "string", "minLength": 1 },
    "logged_at": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["first_segment_id", "last_segment_id", "start_time", "end_time"],
      "properties": {
        "first_segment_id": { "type": "string", "minLength": 1 },
        "last_segment_id": { "type": "string", "minLength": 1 },
        "start_time": { "type": "string", "minLength": 1 },
        "end_time": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "classification_suggestion": {
      "type": ["object", "null"],
      "required": ["label", "confidence", "suggested_by"],
      "properties": { "label": { "type": "string", "minLength": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "suggested_by": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
