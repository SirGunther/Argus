{
  "$id": "argus.transcript-utterance-boundary.v1",
  "type": "object",
  "required": ["boundary_id", "session_id", "utterance_id", "reason", "first_word_sequence", "last_word_sequence", "start_time", "end_time", "punctuation_hint", "source_chunk_ids"],
  "properties": {
    "boundary_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "utterance_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "enum": ["pause", "size", "latency", "flush"] },
    "first_word_sequence": { "type": "integer", "minimum": 0 },
    "last_word_sequence": { "type": "integer", "minimum": 0 },
    "start_time": { "type": "string", "minLength": 1 },
    "end_time": { "type": "string", "minLength": 1 },
    "punctuation_hint": { "type": "string", "enum": ["statement", "question", "exclamation", "unknown"] },
    "source_chunk_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
