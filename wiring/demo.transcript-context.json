{
  "name": "phase4d-transcript-to-context",
  "schema_version": 2,
  "contracts": "../contracts/catalog.json",
  "supervision": { "readiness_timeout_ms": 5000, "drain_timeout_ms": 2000, "operation_timeout_ms": 2000, "queue": { "capacity": 32, "overflow": "fail" } },
  "runtime_components": [
    { "id": "@session-controller", "kind": "session-controller", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": [], "emits": ["lifecycle.start"] } } },
    { "id": "@supervisor", "kind": "supervisor", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": ["service.failure", "service.health", "service.drained", "operation.completed", "operation.rejected", "service.exited"], "emits": ["lifecycle.health-check", "lifecycle.drain", "dead-letter.message"] } } },
    { "id": "@runtime-provider", "kind": "runtime-provider", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": [], "emits": ["service.exited", "service.failure"] } } },
    { "id": "@dead-letter-collector", "kind": "dead-letter-collector", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": ["dead-letter.message"], "emits": [] } } },
    { "id": "@result-collector", "kind": "result-collector", "ports": { "domain": { "accepts": ["transcript.context-window"], "emits": [] }, "control": { "accepts": [], "emits": ["workflow.completed"] } } },
    { "id": "@run-controller", "kind": "run-controller", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": ["workflow.completed"], "emits": [] } } }
  ],
  "services": [
    { "id": "context-policy", "manifest": "../services/context-policy-source/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "audio-source", "manifest": "../services/fake-audio-source/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "transcription-lane", "manifest": "../services/serial-transcription-gate/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "speech-to-text", "manifest": "../services/fake-stt/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "active-transcript", "manifest": "../services/active-transcript-owner/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "contextual-correction", "manifest": "../services/contextual-transcript-corrector/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "transcript-history", "manifest": "../services/permanent-transcript-history/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "context-selector", "manifest": "../services/transcript-window-selector/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "evidence-observer", "manifest": "../services/transcript-evidence-observer/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } }
  ],
  "domain_wires": [
    { "from": "audio-source", "contract": "audio.chunk", "to": "transcription-lane" },
    { "from": "transcription-lane", "contract": "audio.chunk", "to": "speech-to-text" },
    { "from": "speech-to-text", "contract": "transcript.partial", "to": "active-transcript" },
    { "from": "speech-to-text", "contract": "transcript.word-committed", "to": "active-transcript" },
    { "from": "speech-to-text", "contract": "transcript.utterance-boundary", "to": "active-transcript" },
    { "from": "active-transcript", "contract": "transcript.correction-request", "to": "contextual-correction" },
    { "from": "contextual-correction", "contract": "transcript.correction-resolved", "to": "active-transcript" },
    { "from": "active-transcript", "contract": "transcript.segment", "to": "context-selector" },
    { "from": "active-transcript", "contract": "transcript.segment-stored", "to": "evidence-observer" },
    { "from": "active-transcript", "contract": "transcript.history-append", "to": "transcript-history" },
    { "from": "transcript-history", "contract": "transcript.history-appended", "to": "active-transcript" },
    { "from": "transcript-history", "contract": "transcript.history-appended", "to": "evidence-observer" },
    { "from": "context-selector", "contract": "transcript.context-window", "to": "@result-collector" }
  ],
  "control_wires": [
    { "from": "@session-controller", "contract": "lifecycle.start", "to": "context-policy" },
    { "from": "@session-controller", "contract": "lifecycle.start", "to": "audio-source" },
    { "from": "context-policy", "contract": "transcript.context-policy", "to": "context-selector" },
    { "from": "context-selector", "contract": "transcript.context-policy", "to": "audio-source" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "context-policy" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "audio-source" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "transcription-lane" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "speech-to-text" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "active-transcript" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "contextual-correction" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "transcript-history" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "context-selector" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "evidence-observer" },
    { "from": "context-policy", "contract": "service.health", "to": "@supervisor" },
    { "from": "audio-source", "contract": "service.health", "to": "@supervisor" },
    { "from": "transcription-lane", "contract": "service.health", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "service.health", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "service.health", "to": "@supervisor" },
    { "from": "contextual-correction", "contract": "service.health", "to": "@supervisor" },
    { "from": "transcript-history", "contract": "service.health", "to": "@supervisor" },
    { "from": "context-selector", "contract": "service.health", "to": "@supervisor" },
    { "from": "evidence-observer", "contract": "service.health", "to": "@supervisor" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "context-policy" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "audio-source" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "transcription-lane" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "speech-to-text" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "active-transcript" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "contextual-correction" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "transcript-history" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "context-selector" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "evidence-observer" },
    { "from": "context-policy", "contract": "service.drained", "to": "@supervisor" },
    { "from": "audio-source", "contract": "service.drained", "to": "@supervisor" },
    { "from": "transcription-lane", "contract": "service.drained", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "service.drained", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "service.drained", "to": "@supervisor" },
    { "from": "contextual-correction", "contract": "service.drained", "to": "@supervisor" },
    { "from": "transcript-history", "contract": "service.drained", "to": "@supervisor" },
    { "from": "context-selector", "contract": "service.drained", "to": "@supervisor" },
    { "from": "evidence-observer", "contract": "service.drained", "to": "@supervisor" },
    { "from": "context-policy", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "audio-source", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "transcription-lane", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "contextual-correction", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "transcript-history", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "context-selector", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "evidence-observer", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "context-selector", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "context-policy", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "transcription-lane", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "evidence-observer", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "context-policy", "contract": "service.failure", "to": "@supervisor" },
    { "from": "audio-source", "contract": "service.failure", "to": "@supervisor" },
    { "from": "transcription-lane", "contract": "service.failure", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "service.failure", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "service.failure", "to": "@supervisor" },
    { "from": "contextual-correction", "contract": "service.failure", "to": "@supervisor" },
    { "from": "transcript-history", "contract": "service.failure", "to": "@supervisor" },
    { "from": "context-selector", "contract": "service.failure", "to": "@supervisor" },
    { "from": "evidence-observer", "contract": "service.failure", "to": "@supervisor" },
    { "from": "@runtime-provider", "contract": "service.exited", "to": "@supervisor" },
    { "from": "@runtime-provider", "contract": "service.failure", "to": "@supervisor" },
    { "from": "@supervisor", "contract": "dead-letter.message", "to": "@dead-letter-collector" },
    { "from": "@result-collector", "contract": "workflow.completed", "to": "@run-controller" }
  ],
  "run": {
    "session_controller": "@session-controller", "run_controller": "@run-controller", "session_id": "phase4d-demo-session", "completion_count": 1, "timeout_ms": 5000,
    "configuration": {
      "fixture": "correction-question", "await_context_policy": true,
      "context_policy": {
        "policy_id": "phase4d-default", "policy_version": "1.0.0",
        "triggers": { "pause_enabled": true, "max_source_segments": 4, "max_source_chars": 4000, "topic_boundary_after_sequences": [], "max_latency_ms": 8000 },
        "context": { "lookback_segment_count": 2, "forward_segment_count": 0, "max_context_chars": 12000 },
        "generation": { "policy_profile": "neutral-contextual-log", "instruction_version": "1.0.0" }
      }
    }
  }
}
