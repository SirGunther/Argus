{
  "name": "argus-electron-production",
  "schema_version": 2,
  "contracts": "../contracts/catalog.json",
  "supervision": {
    "readiness_timeout_ms": 10000,
    "drain_timeout_ms": 5000,
    "operation_timeout_ms": 15000,
    "queue": { "capacity": 32, "overflow": "fail" }
  },
  "runtime_components": [
    { "id": "@desktop-controller", "kind": "input-source", "ports": { "domain": { "accepts": [], "emits": ["audio.chunk", "audio.flush", "transcript.segment-update", "logged-item.update"] }, "control": { "accepts": [], "emits": ["session.record", "session.stop", "session.resume", "session.close"] } } },
    { "id": "@session-controller", "kind": "session-controller", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": [], "emits": ["lifecycle.start"] } } },
    { "id": "@supervisor", "kind": "supervisor", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": ["service.failure", "service.health", "service.drained", "operation.completed", "operation.rejected", "service.exited"], "emits": ["lifecycle.health-check", "lifecycle.drain", "dead-letter.message"] } } },
    { "id": "@runtime-provider", "kind": "runtime-provider", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": [], "emits": ["service.exited", "service.failure"] } } },
    { "id": "@dead-letter-collector", "kind": "dead-letter-collector", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": ["dead-letter.message"], "emits": [] } } },
    { "id": "@projection-gateway", "kind": "result-collector", "ports": { "domain": { "accepts": ["transcript.partial", "transcript.empty", "transcript.segment", "transcript.segment-stored", "transcript.history-appended", "logged-item.stored", "logged-item.history-appended"], "emits": [] }, "control": { "accepts": ["session.recorded", "session.stopped", "session.resumed", "session.closed", "service.failure"], "emits": ["workflow.completed"] } } },
    { "id": "@run-controller", "kind": "run-controller", "ports": { "domain": { "accepts": [], "emits": [] }, "control": { "accepts": ["workflow.completed"], "emits": [] } } }
  ],
  "services": [
    { "id": "session-lifecycle", "manifest": "../services/session-lifecycle-controller/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "context-policy", "manifest": "../services/context-policy-source/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "speech-to-text", "manifest": "../services/whisper-cpp-stt/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "window-selector", "manifest": "../services/transcript-window-selector/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "active-transcript", "manifest": "../services/active-transcript-owner/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "contextual-correction", "manifest": "../services/contextual-transcript-corrector/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "transcript-history", "manifest": "../services/permanent-transcript-history/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "log-extractor", "manifest": "../services/log-extractor-local-http/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "model-lane", "manifest": "../services/serial-ai-model-lane/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "active-logged-item", "manifest": "../services/active-logged-item-owner/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "logged-item-history", "manifest": "../services/permanent-logged-item-history/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } },
    { "id": "logged-item-evidence", "manifest": "../services/logged-item-evidence-observer/service.json", "required": true, "recovery": { "restart": "never", "max_restarts": 0 } }
  ],
  "domain_wires": [
    { "from": "@desktop-controller", "contract": "audio.chunk", "to": "speech-to-text", "delivery": { "queue_capacity": 8 } },
    { "from": "@desktop-controller", "contract": "audio.flush", "to": "speech-to-text", "delivery": { "operation_timeout_ms": 125000 } },
    { "from": "@desktop-controller", "contract": "transcript.segment-update", "to": "active-transcript" },
    { "from": "@desktop-controller", "contract": "logged-item.update", "to": "active-logged-item" },
    { "from": "speech-to-text", "contract": "transcript.partial", "to": "active-transcript" },
    { "from": "speech-to-text", "contract": "transcript.partial", "to": "@projection-gateway" },
    { "from": "speech-to-text", "contract": "transcript.empty", "to": "@projection-gateway" },
    { "from": "speech-to-text", "contract": "transcript.word-committed", "to": "active-transcript" },
    { "from": "speech-to-text", "contract": "transcript.utterance-boundary", "to": "active-transcript" },
    { "from": "active-transcript", "contract": "transcript.correction-request", "to": "contextual-correction" },
    { "from": "contextual-correction", "contract": "transcript.correction-resolved", "to": "active-transcript" },
    { "from": "active-transcript", "contract": "transcript.segment", "to": "window-selector" },
    { "from": "active-transcript", "contract": "transcript.segment", "to": "@projection-gateway" },
    { "from": "active-transcript", "contract": "transcript.segment-stored", "to": "@projection-gateway" },
    { "from": "active-transcript", "contract": "transcript.history-append", "to": "transcript-history" },
    { "from": "transcript-history", "contract": "transcript.history-appended", "to": "@projection-gateway" },
    { "from": "window-selector", "contract": "transcript.context-window", "to": "log-extractor" },
    { "from": "log-extractor", "contract": "logged-item.draft", "to": "active-logged-item" },
    { "from": "active-logged-item", "contract": "logged-item.stored", "to": "logged-item-evidence" },
    { "from": "active-logged-item", "contract": "logged-item.stored", "to": "@projection-gateway" },
    { "from": "active-logged-item", "contract": "logged-item.history-append", "to": "logged-item-history" },
    { "from": "logged-item-history", "contract": "logged-item.history-appended", "to": "logged-item-evidence" },
    { "from": "logged-item-history", "contract": "logged-item.history-appended", "to": "@projection-gateway" }
  ],
  "control_wires": [
    { "from": "@desktop-controller", "contract": "session.record", "to": "session-lifecycle" },
    { "from": "@desktop-controller", "contract": "session.stop", "to": "session-lifecycle" },
    { "from": "@desktop-controller", "contract": "session.resume", "to": "session-lifecycle" },
    { "from": "@desktop-controller", "contract": "session.close", "to": "session-lifecycle" },
    { "from": "log-extractor", "contract": "ai.work-request", "to": "model-lane" },
    { "from": "model-lane", "contract": "ai.work-completed", "to": "log-extractor" },
    { "from": "@session-controller", "contract": "lifecycle.start", "to": "context-policy" },
    { "from": "context-policy", "contract": "transcript.context-policy", "to": "window-selector" },
    { "from": "session-lifecycle", "contract": "session.recorded", "to": "@projection-gateway" },
    { "from": "session-lifecycle", "contract": "session.stopped", "to": "@projection-gateway" },
    { "from": "session-lifecycle", "contract": "session.resumed", "to": "@projection-gateway" },
    { "from": "session-lifecycle", "contract": "session.closed", "to": "@projection-gateway" },
    { "from": "speech-to-text", "contract": "service.failure", "to": "@projection-gateway" },
    { "from": "model-lane", "contract": "service.failure", "to": "@projection-gateway" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "session-lifecycle" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "context-policy" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "speech-to-text" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "window-selector" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "active-transcript" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "contextual-correction" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "transcript-history" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "log-extractor" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "model-lane" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "active-logged-item" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "logged-item-history" },
    { "from": "@supervisor", "contract": "lifecycle.health-check", "to": "logged-item-evidence" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "session-lifecycle" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "context-policy" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "speech-to-text" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "window-selector" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "active-transcript" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "contextual-correction" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "transcript-history" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "log-extractor" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "model-lane" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "active-logged-item" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "logged-item-history" },
    { "from": "@supervisor", "contract": "lifecycle.drain", "to": "logged-item-evidence" },
    { "from": "session-lifecycle", "contract": "service.health", "to": "@supervisor" },
    { "from": "context-policy", "contract": "service.health", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "service.health", "to": "@supervisor" },
    { "from": "window-selector", "contract": "service.health", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "service.health", "to": "@supervisor" },
    { "from": "contextual-correction", "contract": "service.health", "to": "@supervisor" },
    { "from": "transcript-history", "contract": "service.health", "to": "@supervisor" },
    { "from": "log-extractor", "contract": "service.health", "to": "@supervisor" },
    { "from": "model-lane", "contract": "service.health", "to": "@supervisor" },
    { "from": "active-logged-item", "contract": "service.health", "to": "@supervisor" },
    { "from": "logged-item-history", "contract": "service.health", "to": "@supervisor" },
    { "from": "logged-item-evidence", "contract": "service.health", "to": "@supervisor" },
    { "from": "session-lifecycle", "contract": "service.drained", "to": "@supervisor" },
    { "from": "context-policy", "contract": "service.drained", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "service.drained", "to": "@supervisor" },
    { "from": "window-selector", "contract": "service.drained", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "service.drained", "to": "@supervisor" },
    { "from": "contextual-correction", "contract": "service.drained", "to": "@supervisor" },
    { "from": "transcript-history", "contract": "service.drained", "to": "@supervisor" },
    { "from": "log-extractor", "contract": "service.drained", "to": "@supervisor" },
    { "from": "model-lane", "contract": "service.drained", "to": "@supervisor" },
    { "from": "active-logged-item", "contract": "service.drained", "to": "@supervisor" },
    { "from": "logged-item-history", "contract": "service.drained", "to": "@supervisor" },
    { "from": "logged-item-evidence", "contract": "service.drained", "to": "@supervisor" },
    { "from": "session-lifecycle", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "context-policy", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "context-policy", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "window-selector", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "window-selector", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "contextual-correction", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "transcript-history", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "log-extractor", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "model-lane", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "active-logged-item", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "logged-item-history", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "logged-item-evidence", "contract": "operation.completed", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "active-logged-item", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "session-lifecycle", "contract": "operation.rejected", "to": "@supervisor" },
    { "from": "session-lifecycle", "contract": "service.failure", "to": "@supervisor" },
    { "from": "context-policy", "contract": "service.failure", "to": "@supervisor" },
    { "from": "speech-to-text", "contract": "service.failure", "to": "@supervisor" },
    { "from": "window-selector", "contract": "service.failure", "to": "@supervisor" },
    { "from": "active-transcript", "contract": "service.failure", "to": "@supervisor" },
    { "from": "contextual-correction", "contract": "service.failure", "to": "@supervisor" },
    { "from": "transcript-history", "contract": "service.failure", "to": "@supervisor" },
    { "from": "log-extractor", "contract": "service.failure", "to": "@supervisor" },
    { "from": "model-lane", "contract": "service.failure", "to": "@supervisor" },
    { "from": "active-logged-item", "contract": "service.failure", "to": "@supervisor" },
    { "from": "logged-item-history", "contract": "service.failure", "to": "@supervisor" },
    { "from": "logged-item-evidence", "contract": "service.failure", "to": "@supervisor" },
    { "from": "@runtime-provider", "contract": "service.exited", "to": "@supervisor" },
    { "from": "@runtime-provider", "contract": "service.failure", "to": "@supervisor" },
    { "from": "@supervisor", "contract": "dead-letter.message", "to": "@dead-letter-collector" },
    { "from": "@projection-gateway", "contract": "workflow.completed", "to": "@run-controller" }
  ],
  "run": {
    "session_controller": "@session-controller",
    "run_controller": "@run-controller",
    "session_id": "desktop-bootstrap",
    "completion_count": 1,
    "timeout_ms": 86400000,
    "configuration": {
      "context_policy": {
        "policy_id": "electron-default",
        "policy_version": "1.0.0",
        "triggers": { "pause_enabled": true, "max_source_segments": 3, "max_source_chars": 262144, "topic_boundary_after_sequences": [], "max_latency_ms": 6000 },
        "context": { "lookback_segment_count": 2, "forward_segment_count": 0, "max_context_chars": 262144 },
        "generation": { "policy_profile": "neutral-contextual-log", "instruction_version": "1.0.0" }
      }
    }
  }
}
