{
  "service_name": "log-extractor-local-http",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "includes": [
      "model-boundary.mjs",
      "scribe-batch-boundary.mjs"
    ],
    "environment": {
        "allow": ["ARGUS_MODEL_NAME"]
    }
  },
  "permissions": {},
  "ports": {
    "domain": {
      "accepts": [
        "transcript.context-window"
      ],
      "emits": [
        "logged-item.draft"
      ]
    },
    "control": {
      "accepts": [
        "scribe.batch-policy",
        "ai.work-request",
        "ai.work-completed",
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "ai.work-request",
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed"
      ]
    }
  },
  "state": "bounded in-memory exact retry context for single-window and scribe-batch work, pending capacity 32 each; up to 8 retained scribe batch policies; model-name configuration only",
  "side_effects": []
}
