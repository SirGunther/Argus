{
  "service_name": "active-transcript-owner",
  "version": "1.1.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "environment": {
      "allow": [
        "ARGUS_SESSION_ROOT",
        "ARGUS_DIAGNOSTICS"
      ]
    }
  },
  "permissions": {
    "filesystem": {
      "read": [
        "session-root"
      ],
      "write": [
        "session-root"
      ]
    }
  },
  "ports": {
    "domain": {
      "accepts": [
        "transcript.partial",
        "transcript.word-committed",
        "transcript.utterance-boundary",
        "transcript.correction-resolved",
        "transcript.segment-update",
        "transcript.history-appended"
      ],
      "emits": [
        "transcript.correction-request",
        "transcript.segment",
        "transcript.segment-stored",
        "transcript.history-append"
      ]
    },
    "control": {
      "accepts": [
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed",
        "operation.rejected"
      ]
    }
  },
  "state": "authoritative transcript projection and revisions with a bounded durable pending outbox; active revisions become visible only after exact permanent-history acknowledgement",
  "side_effects": [
    "filesystem:replace-active-transcript-snapshot",
    "filesystem:replace-transcript-pending-outbox"
  ]
}
