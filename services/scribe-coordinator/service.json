{
  "service_name": "scribe-coordinator",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "includes": [
      "eligibility-policy.mjs",
      "batch-identity.mjs",
      "coordinator.mjs"
    ],
    "environment": { "allow": ["ARGUS_DIAGNOSTICS"] }
  },
  "permissions": {},
  "ports": {
    "domain": {
      "accepts": [
        "transcript.segment",
        "scribe.batch-evaluated"
      ],
      "emits": [
        "scribe.batch-admitted"
      ]
    },
    "control": {
      "accepts": [
        "scribe.batch-policy",
        "scribe.recovery-restored",
        "scribe.checkpoint-persisted",
        "scribe.session-closing",
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "scribe.recovery-request",
        "scribe.checkpoint-persist",
        "scribe.session-flushed",
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed",
        "operation.rejected"
      ]
    }
  },
  "state": "bounded Scribe cursor and admission state gated by explicit recovery and durable checkpoint acknowledgement, one in-flight coordinator batch attempt, rolling background context, and one idle timer per bounded session",
  "side_effects": []
}
