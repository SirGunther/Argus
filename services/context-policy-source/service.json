{
  "service_name": "context-policy-source",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs"
  },
  "permissions": {},
  "ports": {
    "domain": {
      "accepts": [],
      "emits": []
    },
    "control": {
      "accepts": [
        "lifecycle.start",
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "transcript.context-policy",
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed",
        "operation.rejected"
      ]
    }
  },
  "state": "stateless policy projection from explicit session configuration",
  "side_effects": []
}
