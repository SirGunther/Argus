{
  "service_name": "permanent-logged-item-history",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "environment": {
      "allow": [
        "ARGUS_SESSION_ROOT"
      ]
    }
  },
  "permissions": {
    "filesystem": {
      "read": [
        "session-root"
      ],
      "write": [
        "session-root"
      ]
    }
  },
  "ports": {
    "domain": {
      "accepts": [
        "logged-item.history-append"
      ],
      "emits": [
        "logged-item.history-appended"
      ]
    },
    "control": {
      "accepts": [
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed"
      ]
    }
  },
  "state": "separate append-only logged-item revision history with an in-memory fallback when no session root is configured",
  "side_effects": [
    "filesystem:append-logged-item-history"
  ]
}
