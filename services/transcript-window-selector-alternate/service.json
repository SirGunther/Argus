{
  "service_name": "transcript-window-selector-alternate",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs"
  },
  "permissions": {},
  "ports": {
    "domain": {
      "accepts": [
        "transcript.segment"
      ],
      "emits": [
        "transcript.context-window"
      ]
    },
    "control": {
      "accepts": [
        "lifecycle.health-check",
        "lifecycle.drain",
        "transcript.context-policy"
      ],
      "emits": [
        "transcript.context-policy",
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed",
        "operation.rejected"
      ]
    }
  },
  "state": "independent minimal session policy and contiguous finalized segment ranges for replacement conformance",
  "side_effects": []
}
