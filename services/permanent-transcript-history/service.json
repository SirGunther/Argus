{
  "service_name": "permanent-transcript-history",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "environment": {
      "allow": [
        "ARGUS_SESSION_ROOT",
        "ARGUS_DIAGNOSTICS"
      ]
    }
  },
  "permissions": {
    "filesystem": {
      "read": [
        "session-root"
      ],
      "write": [
        "session-root"
      ]
    }
  },
  "ports": {
    "domain": {
      "accepts": [
        "transcript.history-append"
      ],
      "emits": [
        "transcript.history-appended"
      ]
    },
    "control": {
      "accepts": [
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed"
      ]
    }
  },
  "state": "append-only authoritative transcript revision history with an in-memory fallback when no session root is configured",
  "side_effects": [
    "filesystem:append-transcript-history"
  ]
}
