{
  "service_name": "serial-ai-model-lane",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "includes": [
      "model-config.mjs"
    ],
    "environment": {
        "allow": [
          "ARGUS_MODEL_ENDPOINT",
          "ARGUS_MODEL_NAME",
          "ARGUS_MODEL_TIMEOUT_MS",
          "ARGUS_MODEL_PROTOCOL"
      ]
    }
  },
  "permissions": {
    "network": {
      "outbound": [
        "loopback-http",
        "external-https"
      ]
    },
    "model_credentials": { "granted": true }
  },
  "ports": {
    "domain": {
      "accepts": [],
      "emits": []
    },
    "control": {
      "accepts": [
        "ai.provider-configure",
        "ai.work-request",
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "ai.work-completed",
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed"
      ]
    }
  },
  "state": "one in-memory SerialAiScheduler for model-backed workloads",
  "side_effects": [
    "configured loopback HTTP or external HTTPS model request"
  ]
}
