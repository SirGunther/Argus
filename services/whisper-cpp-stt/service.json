{
  "service_name": "whisper-cpp-stt",
  "version": "1.1.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "includes": ["preview-scheduler.mjs"],
    "environment": {
      "allow": ["ARGUS_SESSION_ROOT", "ARGUS_WHISPER_BINARY", "ARGUS_WHISPER_MODEL", "ARGUS_WHISPER_TIMEOUT_MS", "ARGUS_WHISPER_DELAYED_MS", "ARGUS_DIAGNOSTICS"]
    }
  },
  "permissions": {
    "filesystem": { "read": ["session-root", "stt-runtime"], "write": ["session-root"] },
    "process": { "granted": true }
  },
  "ports": {
    "domain": {
      "accepts": ["audio.chunk", "audio.flush", "audio.preview"],
      "emits": ["transcript.partial", "transcript.word-committed", "transcript.utterance-boundary", "transcript.empty"]
    },
    "control": {
      "accepts": ["lifecycle.health-check", "lifecycle.drain"],
      "emits": ["service.failure", "service.health", "service.drained", "operation.completed"]
    }
  },
  "state": "bounded in-memory immutable PCM window capped at 10 seconds (with a 120-chunk safety ceiling); raw audio is temporary and deleted after each Whisper invocation",
  "side_effects": ["child-process:whisper.cpp", "filesystem:temporary-session-scoped-wav-and-json"]
}
