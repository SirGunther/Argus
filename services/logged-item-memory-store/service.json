{
  "service_name": "logged-item-memory-store",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "environment": { "allow": ["ARGUS_DIAGNOSTICS"] }
  },
  "permissions": {},
  "ports": {
    "domain": {
      "accepts": [
        "logged-item.draft",
        "logged-item.update",
        "classification.suggestion"
      ],
      "emits": [
        "logged-item.stored",
        "classification.suggestion-accepted"
      ]
    },
    "control": {
      "accepts": [
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed",
        "operation.rejected"
      ]
    }
  },
  "state": "owns in-memory LoggedItem records keyed by item_id",
  "side_effects": []
}
