{
  "service_name": "active-logged-item-owner",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "environment": {
      "allow": [
        "ARGUS_SESSION_ROOT"
      ]
    }
  },
  "permissions": {
    "filesystem": {
      "read": [
        "session-root"
      ],
      "write": [
        "session-root"
      ]
    }
  },
  "ports": {
    "domain": {
      "accepts": [
        "logged-item.draft",
        "logged-item.update",
        "logged-item.update-proposed",
        "logged-item.proposal-resolve"
      ],
      "emits": [
        "logged-item.stored",
        "logged-item.history-append",
        "logged-item.proposal-resolved"
      ]
    },
    "control": {
      "accepts": [
        "lifecycle.health-check",
        "lifecycle.drain"
      ],
      "emits": [
        "service.failure",
        "service.health",
        "service.drained",
        "operation.completed",
        "operation.rejected"
      ]
    }
  },
  "state": "sole active logged-item mutation authority with a durable current projection when a session root is configured",
  "side_effects": [
    "filesystem:replace-active-logged-item-snapshot"
  ]
}
